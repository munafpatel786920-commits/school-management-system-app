
{
  "entities": {
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["basic", "standard", "premium", "yearly", "lifetime"] },
        "studentLimit": { "type": "number" },
        "monthlyPrice": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "School": {
      "title": "School",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled", "expired"] },
        "planId": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date" },
        "smsBalance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "studentCount": { "type": "number" },
        "teacherCount": { "type": "number" },
        "educationBoard": { "type": "string" },
        "locale": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "principalName": { "type": "string" },
        "udiseCode": { "type": "string" },
        "affiliationNo": { "type": "string" },
        "schoolCode": { "type": "string" },
        "logoUrl": { "type": "string", "format": "uri" },
        "academicYear": { "type": "string" }
      }
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "school_admin", "teacher", "accountant"] },
        "schoolId": { "type": "string" }
      }
    },
    "ExamSchedule": {
      "title": "ExamSchedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "examName": { "type": "string" },
        "class": { "type": "string" },
        "schedules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subject": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "time": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ActivationKey": {
      "title": "ActivationKey",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "durationDays": { "type": "number" },
        "studentLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["unused", "redeemed", "revoked"] },
        "customerName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/activation_keys/{keyId}": {
      "schema": { "$ref": "#/entities/ActivationKey" },
      "description": "One-time activation keys generated by Super Admin for customer registration."
    },
    "/plans/{planId}": {
      "schema": { "$ref": "#/entities/SubscriptionPlan" },
      "description": "Available subscription plans managed by Super Admin."
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Core school documents (Tenants)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Global user registry mapping users to roles and schools."
    },
    "/students/{studentId}": { "description": "Student data with schoolId for isolation." },
    "/teachers/{teacherId}": { "description": "Teacher data with schoolId for isolation." },
    "/fees/{feeId}": { "description": "Fee payments with schoolId for isolation." },
    "/sms_logs/{logId}": { "description": "SMS history for schools." },
    "/exam_schedules/{scheduleId}": { 
      "schema": { "$ref": "#/entities/ExamSchedule" },
      "description": "Exam date sheets for classes." 
    }
  }
}
